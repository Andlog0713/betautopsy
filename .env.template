# ── Supabase (required) ──
# Get from: supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (required) ──
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ── Stripe (required for payments) ──
# Without these the app still runs, but /api/checkout returns 503 and every
# upgrade CTA dead-ends. Set all of them before turning pricing on.
#
# Get from: dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=
# Get from: dashboard.stripe.com → Developers → Webhooks → Signing secret.
# Required for /api/webhook — without it, payments succeed at Stripe but the
# user is never upgraded, because the webhook is what flips the tier.
STRIPE_WEBHOOK_SECRET=
#
# Get from: dashboard.stripe.com → Products → Price ID for each product.
# `isStripeConfigured()` only checks SECRET_KEY + PRO_PRICE_ID, so a missing
# REPORT price passes that gate and fails later at checkout with a generic
# error — set all four.
STRIPE_PRO_PRICE_ID=            # Pro subscription, monthly ($19.99/mo)
STRIPE_PRO_ANNUAL_PRICE_ID=     # Pro subscription, annual ($149.99/yr)
STRIPE_REPORT_PRICE_ID=         # One-time full report ($9.99)
STRIPE_EXTRA_REPORT_PRICE_ID=   # Extra report for Pro subscribers ($4.99)
#
# Optional promo codes (promotion code IDs, start with "promo_"). When
# STRIPE_LAUNCH_PROMO is set it is auto-applied at checkout and REPLACES the
# "enter a promo code" box — Stripe does not allow both on one session.
STRIPE_LAUNCH_PROMO=
STRIPE_PROMO_PRODUCTHUNT_ID=

# ── Resend (required for weekly digest emails) ──
# Get from: resend.com → API Keys
RESEND_API_KEY=
# Svix signing secret for the inbound-email webhook (Resend → Webhooks →
# signing secret, starts with whsec_). REQUIRED: /api/inbound-email fails
# closed (503) without it. Leave unset to keep inbound forwarding disabled.
RESEND_INBOUND_SECRET=
# Generate any random string for cron auth (e.g. openssl rand -hex 32)
CRON_SECRET=

# ── App ──
# Set to your production URL when deploying (e.g. https://betautopsy.com).
# Stripe checkout success/cancel URLs are built from this — if it's wrong,
# paying users get redirected to the wrong host after checkout.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Feature flags ──
# Pricing (paywall + tier enforcement + price copy) is ON by default.
# Set to "false" ONLY to run a free beta or a demo build; that serves every
# user the Pro tier for free. Inlined at build time — changing it needs a
# redeploy, not just a restart.
# NEXT_PUBLIC_PRICING_ENABLED=false
